# =============================================================================
# OCTUPOST STACK - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your values.
# This file is committed to git as documentation.
#
# Service URLs (local development):
#   - app (octupost):     http://localhost:3000
#   - studio:             http://localhost:3001
#   - social (mixpost):   http://localhost:3002
#   - api:                http://localhost:8000
#
# Service URLs (production):
#   - app:     https://app.octupost.com
#   - studio:  https://studio.octupost.com
#   - social:  https://social.octupost.com
#   - api:     https://api.octupost.com
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# URL to the octupost-api service
# In development, defaults to http://localhost:8000 if not set
NEXT_PUBLIC_API_URL=

# URL to the octupost-mixpost service
# In development, defaults to http://localhost:3002 if not set
NEXT_PUBLIC_MIXPOST_API_URL=

# -----------------------------------------------------------------------------
# AI Services
# -----------------------------------------------------------------------------
# Fal.ai API key - https://fal.ai/dashboard
FAL_KEY=

# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Inngest (Background Jobs)
# -----------------------------------------------------------------------------
# Get these from your Inngest dashboard - https://app.inngest.com
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# -----------------------------------------------------------------------------
# Sentry (Error Tracking)
# -----------------------------------------------------------------------------
# Shared across all apps
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Per-app Sentry enablement (set to "true" to enable)
NEXT_PUBLIC_SENTRY_ENABLED=false

# Optional: Customize sample rates (0.0 to 1.0)
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_DEBUG=false

# -----------------------------------------------------------------------------
# PostHog (Analytics) - Studio only
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# App Environment
# -----------------------------------------------------------------------------
# Set to "dev", "staging", or "prod"
NEXT_PUBLIC_APP_ENV=dev

# -----------------------------------------------------------------------------
# Agno Platform (Agent Monitoring)
# -----------------------------------------------------------------------------
# Get your API key at https://app.agno.com
AGNO_API_KEY=

OPENROUTER_API_KEY=your_key_here  # Free from openrouter.ai
PEXELS_API_KEY=your_key_here      # Free from pexels.com/api
PIXABAY_API_KEY=your_key_here     # Free from pixabay.com/api/docs