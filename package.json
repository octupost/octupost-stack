{
  "name": "octupost-stack",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "packages/*",
    "frontend",
    "api",
    "mixpost"
  ],
  "scripts": {
    "dev": "npm run dev:app",
    "dev:app": "npm run dev --workspace @octupost/app",
    "dev:api": "npm run dev --workspace @octupost/api",
    "build": "npm run build:app",
    "build:app": "npm run build --workspace @octupost/app",
    "lint": "npm run lint:app",
    "lint:app": "npm run lint --workspace @octupost/app",
    "status": "./scripts/dev.sh status",
    "urls": "./scripts/dev.sh urls",
    "playground": "cd api && source venv/bin/activate && streamlit run playground.py --server.port 8501 --server.headless true"
  },
  "devDependencies": {
    "eslint": "^9.39.1"
  }
}
